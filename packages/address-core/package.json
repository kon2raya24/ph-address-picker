{
  "name": "@ph-dev-utils/address-core",
  "version": "0.1.0",
  "description": "Headless, framework-agnostic state machine for a Philippine cascading address picker (region → province → city → ZIP). Built on @ph-dev-utils/core.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "data",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "philippines",
    "filipino",
    "address",
    "psgc",
    "region",
    "province",
    "city",
    "zip",
    "headless"
  ],
  "dependencies": {
    "@ph-dev-utils/core": "^0.4.0"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "vitest": "^1.5.0"
  }
}
